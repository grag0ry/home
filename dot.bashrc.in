m4_ifdef(<[M4_CFG_WSL]>, <[source "M4_CFG_HOME()/.config/bash/wsl.bashrc"]>)

if shopt -qo history; then
    HISTTIMEFORMAT='%F %T '
    HISTCONTROL="ignoredups"
    HISTSIZE=5000
    HISTFILESIZE=5000
    HISTIGNORE="history:pwd"
fi

if [[ $- != *i* ]] ; then
    # Shell is non-interactive.  Be done now!
    return 0
fi

PROMPT_DIRTRIM=3

m4_include(<[dot.bashrc.func.in]>)

alias tmux="tmux -2"
alias cat="bat"

if [[ -v NERDFONTS ]]; then
    _eza="eza --icons=always"
else
    _eza="eza"
fi

alias ls="$_eza"
alias ll="$_eza -l"
alias la="$_eza -la"

alias lt="$_eza -T"
alias lt2="$_eza -T -L2"
alias lt3="$_eza -T -L3"

alias llg="$_eza -l --git"
alias lag="$_eza -la --git"

unset _eza

# vim: filetype=bash
