#!/bin/bash

set -e -u -o pipefail

repo=${1:?$0: repo required}
version=${2:-latest}

if [ "$version" = "latest" ]; then
    endpoint="releases/latest"
else
    endpoint="releases/tags/$version"
fi

jq_bin=${JQ_BIN:-jq}

{ [ -n "${GITHUB_TOKEN_ENC:-}" ] && printf 'header = "Authorization: Bearer %s"\n' "$(sshseal decrypt < "$GITHUB_TOKEN_ENC")"; :; } \
    | curl --config - -s "https://api.github.com/repos/$repo/$endpoint" \
    | "$jq_bin" -r '.assets.[].browser_download_url'
