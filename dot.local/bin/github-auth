#!/bin/bash

set -e -u -o pipefail

SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")"); readonly SCRIPT_DIR
CRED_HELPER="!$SCRIPT_DIR/github-credential-helper"; readonly CRED_HELPER
KEYRING_TTL=60; readonly KEYRING_TTL

die()  { gum log --level error "$*"; exit 1; }
warn() { gum log --level warn "$*"; }

auth-token-check() {
    [[ -n ${1:-} ]] \
        && printf 'header = "Authorization: Bearer %s"\n' "$1" \
            | curl -fs --config - https://api.github.com/user >/dev/null 2>&1
}

auth() {
    local token=
    if token=$(sealcache decrypt github "$KEYRING_TTL"); then
        auth-token-check "$token" && return 0
        sealcache delete github
    fi

    { : </dev/tty; } 2>/dev/null || die "authentication required"
    while true; do
        token=$(gum input --password --prompt "GitHub PAT: ")
        auth-token-check "$token" && break
        warn "token invalid, try again"
    done

    printf "%s" "$token" | sealcache encrypt github "$KEYRING_TTL"
}

main() {
    auth
    if (( $# == 0 )); then
        printf 'export GITHUB_TOKEN_SEALCACHE_TTL=%q\n' "$KEYRING_TTL"
        printf 'export GITHUB_TOKEN_SEALCACHE_ID=github\n'
        printf 'export GIT_CONFIG_COUNT=1\n'
        printf 'export GIT_CONFIG_KEY_0=%q\n' "credential.https://github.com.helper"
        printf 'export GIT_CONFIG_VALUE_0=%q\n' "$CRED_HELPER"
    else
        export GITHUB_TOKEN_SEALCACHE_ID=github
        export GITHUB_TOKEN_SEALCACHE_TTL="$KEYRING_TTL"
        export GIT_CONFIG_COUNT=1
        export GIT_CONFIG_KEY_0="credential.https://github.com.helper"
        export GIT_CONFIG_VALUE_0="$CRED_HELPER"
        exec "$@"
    fi
}

main "$@"
