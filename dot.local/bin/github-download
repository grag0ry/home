#!/bin/bash

set -e -u -o pipefail

github_token=''
[[ -n ${GITHUB_TOKEN_ENC:-} ]] && github_token=$(sshseal decrypt < "$GITHUB_TOKEN_ENC")

_curl_gh() {
    { [[ -n $github_token ]] && printf 'header = "Authorization: Bearer %s"\n' "$github_token"; :; } \
        | curl --config - "$@"
}

_search_repo() {
    local query
    if command -v gum &>/dev/null; then
        query=$(gum input --placeholder "search..." --header "GitHub") || return 1
    else
        read -r -p "Search GitHub: " query
    fi
    [[ -n $query ]] || return 1

    _curl_gh -s "https://api.github.com/search/repositories?q=${query// /+}&per_page=20" \
        | jq -r '.items[] | "\(.full_name)\t★\(.stargazers_count)\t\(.description // "")"' \
        | column -t -s $'\t' \
        | fzf --prompt="repo> " --no-multi \
        | awk '{print $1}'
}

_select_version() {
    local repo=$1
    _curl_gh -s "https://api.github.com/repos/$repo/releases?per_page=20" \
        | jq -r '.[] | "\(.tag_name)\t\(.name)\t\(if .prerelease then "[pre]" else "" end)"' \
        | column -t -s $'\t' \
        | fzf --prompt="version> " --no-multi \
        | awk '{print $1}'
}

_resolve_tag() {
    local repo=$1 version=$2
    if [[ $version == latest ]]; then
        _curl_gh -s "https://api.github.com/repos/$repo/releases/latest" | jq -r '.tag_name'
    else
        printf '%s\n' "$version"
    fi
}

repo=${1:-}
version=${2:-}

if [[ -z $repo ]]; then
    repo=$(_search_repo) || exit 0
fi
[[ -n $repo ]] || exit 0

if [[ -z $version ]]; then
    version=$(_select_version "$repo") || exit 0
fi
[[ -n $version ]] || exit 0

tag=$(_resolve_tag "$repo" "$version")

mapfile -t urls < <(
    {
        github-assets "$repo" "$version"
        printf '%s\n' \
            "https://github.com/$repo/archive/refs/tags/$tag.tar.gz" \
            "https://github.com/$repo/archive/refs/tags/$tag.zip"
    } | fzf --prompt="$repo $version> " -m
)
[[ ${#urls[@]} -gt 0 ]] || exit 0

for url in "${urls[@]}"; do
    file=$(basename "$url")
    _curl_gh -L --progress-bar "$url" -o "$file"
done
