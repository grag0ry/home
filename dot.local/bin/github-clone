#!/bin/bash

set -e -u -o pipefail

_search_repo() {
    local query
    if command -v gum &>/dev/null; then
        query=$(gum input --placeholder "search..." --header "GitHub") || return 1
    else
        read -r -p "Search GitHub: " query
    fi
    [[ -n $query ]] || return 1

    github-curl -s "https://api.github.com/search/repositories?q=${query// /+}&per_page=20" \
        | jq -r '.items[] | "\(.full_name)\t★\(.stargazers_count)\t\(.description // "")"' \
        | column -t -s $'\t' \
        | fzf --prompt="repo> " --no-multi \
        | awk '{print $1}'
}

repo=${1:-}
shift || :
if [[ -z $repo || $repo = '-' ]]; then
    repo=$(_search_repo) || exit 0
fi

[[ -n $repo ]] || exit 0

exec git clone "https://github.com/$repo.git" "$@"
