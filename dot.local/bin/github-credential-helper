#!/bin/bash

set -e -u -o pipefail

action=${1:?github-credential-helper: action required}

case "$action" in
    get) ;;
    store|erase) exit 0 ;;
    *) exit 0 ;;
esac

[[ -n ${GITHUB_TOKEN_ENC:-} ]] || { printf 'github-credential-helper: GITHUB_TOKEN_ENC not set\n' >&2; exit 1; }

token=$(sshseal decrypt < "$GITHUB_TOKEN_ENC") \
    || { printf 'github-credential-helper: failed to decrypt token\n' >&2; exit 1; }

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
