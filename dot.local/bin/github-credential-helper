#!/bin/bash

set -e -u -o pipefail

action=${1:?github-credential-helper: action required}

case "$action" in
    get) ;;
    store|erase) exit 0 ;;
    *) exit 0 ;;
esac

[[ -n ${GITHUB_TOKEN_SEALCACHE_ID:-} ]] \
    || { echo 'github-credential-helper: GITHUB_TOKEN_SEALCACHE_ID not set\n' >&2; exit 1; }

echo "username=x-access-token"
echo -n "password="
sealcache decrypt "$GITHUB_TOKEN_SEALCACHE_ID" "${GITHUB_TOKEN_SEALCACHE_TTL:-}" \
    || { echo 'github-credential-helper: failed to decrypt token\n' >&2; exit 1; }
