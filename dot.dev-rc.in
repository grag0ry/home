if (( EUID == 0 )); then
    PS1='\[\e[01;33m\](dev)\[\e[00m\] \[\e[01;31m\]\h\[\e[01;34m\] \w \$\[\e[00m\] '
else
    PS1='\[\e[01;33m\](dev)\[\e[00m\] \[\e[01;32m\]\u@\h\[\e[01;34m\] \w \$\[\e[00m\] '
fi

m4_include(<[./dot.config/bash/colors.bash]>)

# cheat: fzf defaults to a floating tmux popup at 40% height
export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --height 40% --tmux"

# cheat: nnn plugins - press ;f / ;g inside nnn to launch the f/g shell functions above
export NNN_DEV_RC="${BASH_SOURCE[0]}"
export NNN_OPTS="AcEo"
export NNN_TMPFILE="/tmp/nnn-lastd.$USER"
export NNN_PLUG='f:!bash -c ". $NNN_DEV_RC && f";g:-!bash -c ". $NNN_DEV_RC && g"'

xopen() { "$EDITOR" "$1"; }

m4_include(<[dot.bashrc.func.in]>)

